      "nodeData": {
        "codeText": "#\u003Cblocks_def\u003E\nfrom InputFileLocator import InputFileLocator\nfrom ExcelSheetReader import ExcelSheetReader\nfrom B2BIncomeCalculator import B2BIncomeCalculator\nfrom HouseholdLoader import HouseholdLoader\nfrom BankOfferLoader import BankOfferLoader\nfrom NbpRateClient import NbpRateClient\nfrom ScheduleBuilder import ScheduleBuilder\nfrom PlnFormat import PlnFormat\nfrom CreditAssessor import CreditAssessor\nfrom MortgageCalculator import MortgageCalculator\nfrom AnalizaKredytuHipotecznego import AnalizaKredytuHipotecznego\nfrom MortgageReportPdf import MortgageReportPdf\n#\u003Cend_of_block_defs\u003E\n\ndef main():\n#\u003Cblocks_call\u003E\n\tlocator = InputFileLocator()\n\tdata_1 = locator.locator()\n\treader = ExcelSheetReader()\n\tdata_2 = reader.reader()\n\tb2b_income = B2BIncomeCalculator()\n\tdata_b2b = b2b_income.b2b_income()\n\thousehold = HouseholdLoader(data_1, data_2, data_b2b)\n\tdata_3 = household.household()\n\tdata_4 = household.project()\n\toffers = BankOfferLoader(data_1, data_2)\n\tdata_5 = offers.offers()\n\tdata_6 = offers.market()\n\treference_rate = NbpRateClient()\n\tdata_7 = reference_rate.reference_rate()\n\tbuilder = ScheduleBuilder()\n\tdata_8 = builder.builder()\n\tformatter = PlnFormat()\n\tdata_9 = formatter.formatter()\n\tassessor = CreditAssessor(data_9)\n\tdata_10 = assessor.assessor()\n\tcalculator = MortgageCalculator(data_3, data_4, data_5, data_6, data_7, data_8, data_10)\n\tdata_11 = calculator.calculator()\n\tresult = AnalizaKredytuHipotecznego(data_11, data_9, data_b2b)\n\tresult.show()\n\tdef _on_result_zapisz(data_12):\n\t\tzapisany_pdf = MortgageReportPdf(data_12, data_9)\n\t\tdata_13 = zapisany_pdf.pdf_path()\n\tresult.bind_action(\u0027zapisz\u0027, _on_result_zapisz)\n#\u003Cend_of_block_calls\u003E\n\tpass\n\nif __name__ == \u0022__main__\u0022:\n\tmain()\n",
